{
  "schema_version": 2,
  "id": 2,
  "name": "Dirt",
  "internal_name": "dirt",

  "physical": {
    "density": 200,
    "category": "powder"
  },

  "thermal": {
    "default_temp": 128,
    "conductivity": 0.2
  },

  "rendering": {
    "default_color": "#8B6914FF",
