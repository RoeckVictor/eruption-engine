#version 450 core

layout(local_size_x = 16, local_size_y = 16) in;

// Pixel data SSBOs (ping-pong arrangement)
layout(std430, binding = 0) readonly buffer PixelBufferRead {
    uint pixels_read[];
};

layout(std430, binding = 1) writeonly buffer PixelBufferWrite {
    uint pixels_write[];
};

// Material properties SSBO - 2 uints per material
layout(std430, binding = 2) readonly buffer MaterialTable {
    uint mat_props[512];
};

// Dirty chunk flags SSBO - one uint per chunk, set atomically when pixels move
layout(std430, binding = 3) coherent buffer DirtyChunks {
    uint dirty_chunks[];
};

uniform int u_phase;
uniform int u_grid_width;
uniform int u_grid_height;
uniform uint u_frame;
uniform uint u_pixel_size;  // bytes per pixel (4 for basic, more for extended)

// Chunk tracking uniforms
uniform int u_chunk_size_x;
uniform int u_chunk_size_y;
uniform int u_num_chunks_x;

// Material ID uniforms (avoids hardcoded magic numbers)
uniform uint u_mat_water;
uniform uint u_mat_lava;
uniform uint u_mat_ice;
uniform uint u_mat_steam;

#define PIXEL_READ_SSBO pixels_read
#include "include/pixel_access.glsl"
#include "include/material_props.glsl"

// Load pixel from read SSBO at grid position
uvec4 loadPixel(ivec2 pos) {
    return unpackPixel(readPackedPixel(pos));
}

// Store pixel to write SSBO at grid position.
// SAFETY: The Margolus scheme guarantees each 2x2 block is processed by exactly
// one invocation with no overlap, so concurrent writes to different positions
// are safe without atomics for the aligned 4-byte case.
void storePixel(ivec2 pos, uvec4 pixel) {
    uint idx = uint(pos.y) * uint(u_grid_width) + uint(pos.x);
    uint byte_offset = idx * u_pixel_size;
    uint word_offset = byte_offset / 4u;

    uint packed = packPixel(pixel);

    // Only the aligned 4-byte path is supported. The engine always uses
    // u_pixel_size == 4, so this is the only active code path.
    pixels_write[word_offset] = packed;
}

// Helper to update material and sync category in G channel
void setMaterial(inout uvec4 pixel, uint newMat) {
    pixel.r = newMat;
    pixel.g = getCategory(newMat);
}

uint hash(uvec3 v) {
    uint h = v.x * 1973u + v.y * 9277u + v.z * 26699u;
    h = (h ^ (h >> 16)) * 0x45d9f3bu;
    h = (h ^ (h >> 16)) * 0x45d9f3bu;
    return h ^ (h >> 16);
}

// Mark the chunk containing pixel position (px, py) as dirty.
// Uses atomicOr for thread-safe flag setting without race conditions.
void markChunkDirty(ivec2 pixel_pos) {
    int cx = pixel_pos.x / u_chunk_size_x;
    int cy = pixel_pos.y / u_chunk_size_y;
    int chunk_idx = cy * u_num_chunks_x + cx;
    atomicOr(dirty_chunks[chunk_idx], 1u);
}

// Mark the chunk containing a 2x2 block as dirty (block_base is top-left corner)
void markBlockChunksDirty(ivec2 block_base) {
    // A 2x2 block can span up to 4 chunks at chunk boundaries.
    // Mark all potentially affected chunks.
    int cx0 = block_base.x / u_chunk_size_x;
    int cy0 = block_base.y / u_chunk_size_y;
    int cx1 = (block_base.x + 1) / u_chunk_size_x;
    int cy1 = (block_base.y + 1) / u_chunk_size_y;

    atomicOr(dirty_chunks[cy0 * u_num_chunks_x + cx0], 1u);
    if (cx1 != cx0) atomicOr(dirty_chunks[cy0 * u_num_chunks_x + cx1], 1u);
    if (cy1 != cy0) atomicOr(dirty_chunks[cy1 * u_num_chunks_x + cx0], 1u);
    if (cx1 != cx0 && cy1 != cy0) atomicOr(dirty_chunks[cy1 * u_num_chunks_x + cx1], 1u);
}

// Fast category access using cached pixel.g (already stored during init/setMaterial)
// This avoids the SSBO lookup in getCategory(pixel.r)
uint getCategoryFast(uvec4 pixel) {
    return pixel.g;
}

// ---- Direct contact reaction for specific material pairs ----
// Returns true if a reaction occurred.
bool tryContactReact(inout uvec4 a, inout uvec4 b, uint rng) {
    uint mA = a.r, mB = b.r;

    // Lava + Water -> Steam + cooled Lava (probabilistic so it's not instant)
    if (mA == u_mat_lava && mB == u_mat_water && (rng & 3u) == 0u) {
        setMaterial(b, u_mat_steam); b.b = 200u;
        a.b = a.b > 40u ? a.b - 40u : 0u;
        return true;
    }
    if (mB == u_mat_lava && mA == u_mat_water && (rng & 3u) == 0u) {
        setMaterial(a, u_mat_steam); a.b = 200u;
        b.b = b.b > 40u ? b.b - 40u : 0u;
        return true;
    }

    // Lava + Ice -> Water + cooled Lava
    if (mA == u_mat_lava && mB == u_mat_ice && (rng & 3u) == 0u) {
        setMaterial(b, u_mat_water); b.b = 128u;
        a.b = a.b > 30u ? a.b - 30u : 0u;
        return true;
    }
    if (mB == u_mat_lava && mA == u_mat_ice && (rng & 3u) == 0u) {
        setMaterial(a, u_mat_water); a.b = 128u;
        b.b = b.b > 30u ? b.b - 30u : 0u;
        return true;
    }

    return false;
}

bool tryReact(inout uvec4 a, inout uvec4 b, uint rng) {
    uint matA = a.r, matB = b.r;
    if (matA == matB) return false;

    // Use cached category from pixel.g (faster than SSBO lookup)
    uint catA = getCategoryFast(a);
    uint catB = getCategoryFast(b);

    // Skip if either cell is air
    if (catA == CAT_EMPTY || catB == CAT_EMPTY) return false;

    // Immediate contact reactions for specific pairs
    if (tryContactReact(a, b, rng)) return true;

    // General temperature diffusion for everything else
    uint tempA = a.b, tempB = b.b;
    bool reacted = false;

    if (tempA > tempB + 5u) {
        uint transfer = min((tempA - tempB) / 3u, 30u);
        a.b = tempA - transfer;
        b.b = tempB + transfer;
        tempA = a.b;
        tempB = b.b;
    } else if (tempB > tempA + 5u) {
        uint transfer = min((tempB - tempA) / 3u, 30u);
        b.b = tempB - transfer;
        a.b = tempA + transfer;
        tempA = a.b;
        tempB = b.b;
    }

    // Melt check (solid->liquid, e.g. ice->water via general heat)
    uint meltB = getMeltPoint(matB);
    if (meltB > 0u && tempB >= meltB) {
        setMaterial(b, getMeltInto(matB));
        b.b = tempB > 10u ? tempB - 10u : 0u;
        reacted = true;
    }
    uint meltA = getMeltPoint(matA);
    if (meltA > 0u && tempA >= meltA) {
        setMaterial(a, getMeltInto(matA));
        a.b = tempA > 10u ? tempA - 10u : 0u;
        reacted = true;
    }

    // Re-read material IDs after melt (they may have changed)
    matA = a.r;
    matB = b.r;
    tempA = a.b;
    tempB = b.b;

    // Boil check (liquid->gas, e.g. water->steam via general heat)
    uint boilB = getBoilPoint(matB);
    if (boilB > 0u && tempB >= boilB) {
        setMaterial(b, getBoilInto(matB));
        b.b = tempB > 20u ? tempB - 20u : 0u;
        reacted = true;
    }
    uint boilA = getBoilPoint(matA);
    if (boilA > 0u && tempA >= boilA) {
        setMaterial(a, getBoilInto(matA));
        a.b = tempA > 20u ? tempA - 20u : 0u;
        reacted = true;
    }

    // Cooled lava evaporates into steam
    if (a.r == u_mat_lava && a.b < 100u) { setMaterial(a, u_mat_steam); a.b = 180u; reacted = true; }
    if (b.r == u_mat_lava && b.b < 100u) { setMaterial(b, u_mat_steam); b.b = 180u; reacted = true; }

    return reacted;
}

// ---- Gravity swap: A is above, B is below ----
// Falls into empty space, and powders sink through liquids.
bool trySwapGravity(inout uvec4 a, inout uvec4 b) {
    // Use cached category from pixel.g (faster than SSBO lookup)
    uint catA = getCategoryFast(a);
    uint catB = getCategoryFast(b);

    // Powder/liquid falls into empty
    if ((catA == CAT_POWDER || catA == CAT_LIQUID) && catB == CAT_EMPTY) {
        uvec4 tmp = a; a = b; b = tmp;
        return true;
    }
    // Powder sinks through liquid (sand falls through water)
    if (catA == CAT_POWDER && catB == CAT_LIQUID) {
        uvec4 tmp = a; a = b; b = tmp;
        return true;
    }
    return false;
}

void main() {
    // Margolus neighborhood phase offset (alternates 2x2 block origin each frame)
    int phase_offset_x = u_phase & 1;
    int phase_offset_y = (u_phase >> 1) & 1;

    ivec2 block_base = ivec2(gl_GlobalInvocationID.xy) * 2 + ivec2(phase_offset_x, phase_offset_y);

    // Bounds check
    if (block_base.x + 1 >= u_grid_width || block_base.y + 1 >= u_grid_height ||
        block_base.x < 0 || block_base.y < 0) {
        for (int dy = 0; dy < 2; dy++) {
            for (int dx = 0; dx < 2; dx++) {
                ivec2 p = block_base + ivec2(dx, dy);
                if (p.x >= 0 && p.x < u_grid_width && p.y >= 0 && p.y < u_grid_height) {
                    storePixel(p, loadPixel(p));
                }
            }
        }
        return;
    }

    // Load 2x2 block: TL TR / BL BR
    uvec4 tl = loadPixel(block_base + ivec2(0, 0));
    uvec4 tr = loadPixel(block_base + ivec2(1, 0));
    uvec4 bl = loadPixel(block_base + ivec2(0, 1));
    uvec4 br = loadPixel(block_base + ivec2(1, 1));

    // ---- EARLY-OUT: Skip processing if all pixels are empty or static ----
    // These blocks cannot change, so we can write them unchanged immediately.
    uint cat_tl = getCategoryFast(tl);
    uint cat_tr = getCategoryFast(tr);
    uint cat_bl = getCategoryFast(bl);
    uint cat_br = getCategoryFast(br);

    bool tl_static = (cat_tl == CAT_EMPTY || cat_tl == CAT_STATIC);
    bool tr_static = (cat_tr == CAT_EMPTY || cat_tr == CAT_STATIC);
    bool bl_static = (cat_bl == CAT_EMPTY || cat_bl == CAT_STATIC);
    bool br_static = (cat_br == CAT_EMPTY || cat_br == CAT_STATIC);

    if (tl_static && tr_static && bl_static && br_static) {
        // All pixels are immobile - write unchanged and skip all physics
        storePixel(block_base + ivec2(0, 0), tl);
        storePixel(block_base + ivec2(1, 0), tr);
        storePixel(block_base + ivec2(0, 1), bl);
        storePixel(block_base + ivec2(1, 1), br);
        return;
    }

    // Single base hash, derive variants via XOR (cheaper than multiple hash() calls)
    uint base_rng = hash(uvec3(block_base, u_frame * 4u + u_phase));
    uint rng = base_rng;

    // ---- PASS 1: Contact reactions (temperature transfer + state changes) ----
    // Process ALL adjacent pairs for reactions BEFORE movement.
    uint react_rng = base_rng ^ 0x9E3779B9u;  // Golden ratio derived variant
    tryReact(tl, tr, react_rng);
    tryReact(bl, br, react_rng >> 2u);
    tryReact(tl, bl, react_rng >> 4u);
    tryReact(tr, br, react_rng >> 6u);
    tryReact(tl, br, react_rng >> 8u);
    tryReact(tr, bl, react_rng >> 10u);

    // ---- PASS 2: Gravity (vertical, heavy sinks) ----
    // Track if any movement occurred to mark chunks dirty
    bool moved = false;

    if (trySwapGravity(tl, bl)) moved = true;
    if (trySwapGravity(tr, br)) moved = true;

    // ---- PASS 3: Diagonal slide for powders ----
    // Re-read categories after potential swaps
    cat_tl = getCategoryFast(tl);
    cat_tr = getCategoryFast(tr);
    cat_bl = getCategoryFast(bl);
    cat_br = getCategoryFast(br);

    if ((rng & 2u) != 0u) {
        if (cat_tl == CAT_POWDER && cat_br == CAT_EMPTY) {
            uvec4 tmp = tl; tl = br; br = tmp;
            moved = true;
        }
        // Re-read after potential swap
        cat_tr = getCategoryFast(tr);
        cat_bl = getCategoryFast(bl);
        if (cat_tr == CAT_POWDER && cat_bl == CAT_EMPTY) {
            uvec4 tmp = tr; tr = bl; bl = tmp;
            moved = true;
        }
    } else {
        if (cat_tr == CAT_POWDER && cat_bl == CAT_EMPTY) {
            uvec4 tmp = tr; tr = bl; bl = tmp;
            moved = true;
        }
        // Re-read after potential swap
        cat_tl = getCategoryFast(tl);
        cat_br = getCategoryFast(br);
        if (cat_tl == CAT_POWDER && cat_br == CAT_EMPTY) {
            uvec4 tmp = tl; tl = br; br = tmp;
            moved = true;
        }
    }

    // ---- PASS 4: Lateral spread for liquids ----
    rng = base_rng ^ 0x85EBCA6Bu;  // Derived variant for liquid spread
    // Re-read categories
    cat_tl = getCategoryFast(tl);
    cat_tr = getCategoryFast(tr);
    cat_bl = getCategoryFast(bl);
    cat_br = getCategoryFast(br);

    // Top row
    if (cat_tl == CAT_LIQUID && cat_tr == CAT_EMPTY && (rng & 1u) == 0u) {
        uvec4 tmp = tl; tl = tr; tr = tmp;
        moved = true;
    } else if (cat_tr == CAT_LIQUID && cat_tl == CAT_EMPTY && (rng & 1u) == 0u) {
        uvec4 tmp = tl; tl = tr; tr = tmp;
        moved = true;
    }
    // Bottom row
    cat_bl = getCategoryFast(bl);
    cat_br = getCategoryFast(br);
    if (cat_bl == CAT_LIQUID && cat_br == CAT_EMPTY && (rng & 4u) == 0u) {
        uvec4 tmp = bl; bl = br; br = tmp;
        moved = true;
    } else if (cat_br == CAT_LIQUID && cat_bl == CAT_EMPTY && (rng & 4u) == 0u) {
        uvec4 tmp = bl; bl = br; br = tmp;
        moved = true;
    }

    // ---- PASS 5: Gas rises ----
    rng = base_rng ^ 0xC2B2AE35u;  // Derived variant for gas movement
    // Re-read categories
    cat_tl = getCategoryFast(tl);
    cat_tr = getCategoryFast(tr);
    cat_bl = getCategoryFast(bl);
    cat_br = getCategoryFast(br);

    // Gas rises (swap upward if above is empty or non-gas mobile)
    if (cat_bl == CAT_GAS && (cat_tl == CAT_EMPTY ||
        (isMobile(cat_tl) && cat_tl != CAT_GAS)) && (rng & 3u) != 0u) {
        uvec4 tmp = tl; tl = bl; bl = tmp;
        moved = true;
    }
    cat_tr = getCategoryFast(tr);
    cat_br = getCategoryFast(br);
    if (cat_br == CAT_GAS && (cat_tr == CAT_EMPTY ||
        (isMobile(cat_tr) && cat_tr != CAT_GAS)) && (rng & 12u) != 0u) {
        uvec4 tmp = tr; tr = br; br = tmp;
        moved = true;
    }
    // Gas lateral spread
    cat_tl = getCategoryFast(tl);
    cat_tr = getCategoryFast(tr);
    if (cat_tl == CAT_GAS && cat_tr == CAT_EMPTY && (rng & 16u) != 0u) {
        uvec4 tmp = tl; tl = tr; tr = tmp;
        moved = true;
    } else if (cat_tr == CAT_GAS && cat_tl == CAT_EMPTY && (rng & 16u) != 0u) {
        uvec4 tmp = tl; tl = tr; tr = tmp;
        moved = true;
    }

    // ---- PASS 6: Gas dissipation ----
    // Process directly without temporary array (avoid extra indirection)
    cat_tl = getCategoryFast(tl);
    if (cat_tl == CAT_GAS) {
        uint drng = hash(uvec3(block_base, u_frame + 999u));
        if ((drng & 63u) == 0u) {
            tl = uvec4(0u, 0u, 128u, 0u); // dissipate to AIR
            moved = true;
        }
    }
    cat_tr = getCategoryFast(tr);
    if (cat_tr == CAT_GAS) {
        uint drng = hash(uvec3(block_base + ivec2(1, 0), u_frame + 999u));
        if ((drng & 63u) == 0u) {
            tr = uvec4(0u, 0u, 128u, 0u);
            moved = true;
        }
    }
    cat_bl = getCategoryFast(bl);
    if (cat_bl == CAT_GAS) {
        uint drng = hash(uvec3(block_base + ivec2(0, 1), u_frame + 999u));
        if ((drng & 63u) == 0u) {
            bl = uvec4(0u, 0u, 128u, 0u);
            moved = true;
        }
    }
    cat_br = getCategoryFast(br);
    if (cat_br == CAT_GAS) {
        uint drng = hash(uvec3(block_base + ivec2(1, 1), u_frame + 999u));
        if ((drng & 63u) == 0u) {
            br = uvec4(0u, 0u, 128u, 0u);
            moved = true;
        }
    }

    // Mark affected chunks as dirty if any pixel moved
    if (moved) {
        markBlockChunksDirty(block_base);
    }

    // ---- Write results ----
    storePixel(block_base + ivec2(0, 0), tl);
    storePixel(block_base + ivec2(1, 0), tr);
    storePixel(block_base + ivec2(0, 1), bl);
    storePixel(block_base + ivec2(1, 1), br);
}
