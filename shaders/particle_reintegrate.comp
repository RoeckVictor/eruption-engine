#version 450

layout(local_size_x = 256) in;

#include "include/particle.glsl"

layout(std430, binding = 3) buffer ParticleBuffer {
    Particle particles[];
};

layout(std430, binding = 4) buffer DeadListBuffer {
    uint dead_count;
    uint dead_indices[];
};

// Material properties SSBO for category lookup
layout(std430, binding = 2) readonly buffer MaterialTable {
    uint mat_props[512];
};

// Both pixel SSBOs (write to both to keep ping-pong in sync)
layout(std430, binding = 0) buffer PixelBufferA {
    uint pixels_a[];
};

layout(std430, binding = 1) buffer PixelBufferB {
    uint pixels_b[];
};

uniform int  u_grid_width;
uniform int  u_grid_height;
uniform uint u_max_particles;
uniform uint u_pixel_size;  // bytes per pixel

#define PIXEL_READ_SSBO pixels_a
#include "include/pixel_access.glsl"
#include "include/material_props.glsl"

// Load material ID from pixel buffer A
uint loadMaterial(uint wx, uint wy) {
    return readPackedPixel(ivec2(wx, wy)) & 0xFFu;
}

// Store pixel to both SSBOs (for aligned 4-byte pixels)
void storePixelBoth(uint wx, uint wy, uint material, uint category, uint temperature, uint flags) {
    uint idx = wy * uint(u_grid_width) + wx;
    uint byte_offset = idx * u_pixel_size;
    uint word_offset = byte_offset / 4u;

    uint packed = packPixel(uvec4(material, category, temperature, flags));

    // For now, assume aligned 4-byte pixels (common case)
    // TODO: Handle misaligned/larger pixels if needed
    pixels_a[word_offset] = packed;
    pixels_b[word_offset] = packed;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= u_max_particles) return;

    Particle p = particles[idx];
    if (p.flags != 2u) return; // only process reintegration-flagged particles

    int wx = int(floor(p.pos.x));
    int wy = int(floor(p.pos.y));

    // Bounds check
    if (wx >= 0 && wx < u_grid_width && wy >= 0 && wy < u_grid_height) {
        // Only write if the target cell is currently empty
        uint existing_mat = loadMaterial(uint(wx), uint(wy));
        if (existing_mat == 0u) {
            // Write material to both ping-pong SSBOs
            uint cat = getCategory(p.material);
            uint temp = getDefaultTemp(p.material);
            storePixelBoth(uint(wx), uint(wy), p.material, cat, temp, 0u);
        }
    }

    // Kill the particle
    p.flags = 0u;
    uint slot = atomicAdd(dead_count, 1u);
    if (slot < u_max_particles) {
        dead_indices[slot] = idx;
    }

    particles[idx] = p;
}
