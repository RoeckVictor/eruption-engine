#version 450 core

layout(local_size_x = 16, local_size_y = 16) in;

// Pixel data SSBO (read)
layout(std430, binding = 0) readonly buffer PixelBuffer {
    uint pixel_data[];
};

// Render texture (write)
// Binding 7 avoids conflict with SSBO at binding 0 (Vulkan requires unique bindings
// per descriptor set; OpenGL uses separate namespaces so any number works).
layout(rgba8ui, binding = 7) writeonly uniform uimage2D u_render_texture;

#ifdef VULKAN
layout(push_constant) uniform PushConstants {
    int u_grid_width;
    int u_grid_height;
    uint u_pixel_size;
};
#else
uniform int u_grid_width;
uniform int u_grid_height;
uniform uint u_pixel_size;
#endif

#include "include/pixel_access.glsl"

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= u_grid_width || pos.y >= u_grid_height) return;

    uint packed = readPackedPixel(pos);
    uvec4 pixel = unpackPixel(packed);

    imageStore(u_render_texture, pos, pixel);
}
