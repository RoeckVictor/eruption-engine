#version 450 core

layout(local_size_x = 16, local_size_y = 16) in;

// Pixel data SSBO (read)
layout(std430, binding = 0) readonly buffer PixelBuffer {
    uint pixel_data[];
};

// Render texture (write)
layout(rgba8ui, binding = 0) writeonly uniform uimage2D u_render_texture;

uniform int u_grid_width;
uniform int u_grid_height;
uniform uint u_pixel_size;

#include "include/pixel_access.glsl"

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= u_grid_width || pos.y >= u_grid_height) return;

    uint packed = readPackedPixel(pos);
    uvec4 pixel = unpackPixel(packed);

    imageStore(u_render_texture, pos, pixel);
}
